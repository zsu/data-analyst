    },
    "startdate": {
     "desc": "YYYY-MM-DD"
    },
    "enddate": {
     "desc": "YYYY-MM-DD"
    },
    "sortfield": {
     "desc": "id, name, mindate, maxdate, datacoverage"
    },
    "sortorder": {
     "desc": "asc or desc"
    },
    "extent": {
     "desc": "stations only: south,west,north,east bounding box"
    },
    "locationcategoryid": {
     "desc": "locations only: ST, CNTY, CITY, CLIM_REG, CNTRY ..."
    }
   },
   "defaults": {
