   },
   "records": "results",
   "total": "metadata.resultset.count",
   "paging": {
    "type": "offset",
    "limit_param": "limit",
    "offset_param": "offset",
    "size": 1000
   },
   "max_rows": 1000,
   "missing": [
    ""
   ],
   "flatten": true
  },
  "cdo_datatypes": {
   "path": "/cdo-web/api/v2/datatypes",
   "method": "GET",
   "description": "Data types available for a dataset, station or location (CDO v2, needs NOAA_API_KEY)",
   "params": {
    "datasetid": {
