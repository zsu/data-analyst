   ],
   "flatten": true
  }
 },
 "catalog": {
  "daily": {
   "id": "daily-summaries",
   "name": "GHCN-Daily (CDO GHCND)",
   "description": "daily max/min temperature, precipitation, snowfall, snow depth, wind by station",
   "endpoint": "data"
  },
  "monthly": {
   "id": "global-summary-of-the-month",
   "name": "Global Summary of the Month (CDO GSOM)",
   "description": "monthly mean/max/min temperature, total precipitation and snow, degree days",
   "endpoint": "data"
  },
  "annual": {
   "id": "global-summary-of-the-year",
   "name": "Global Summary of the Year (CDO GSOY)",
   "description": "annual temperature and precipitation summaries",
   "endpoint": "data"
  },
  "normals_monthly": {
   "id": "normals-monthly-1991-2020",
   "name": "U.S. Climate Normals 1991-2020, monthly",
   "description": "30-year monthly normals (MLY-TAVG-NORMAL, MLY-PRCP-NORMAL ...)",
   "endpoint": "data"
  },
  "normals_daily": {
   "id": "normals-daily-1991-2020",
   "name": "U.S. Climate Normals 1991-2020, daily",
   "description": "30-year daily normals (DLY-TMAX-NORMAL ...)",
   "endpoint": "data"
  },
  "normals_annual": {
   "id": "normals-annualseasonal-1991-2020",
   "name": "U.S. Climate Normals 1991-2020, annual/seasonal",
   "description": "annual and seasonal normals (ANN-TAVG-NORMAL ...)",
   "endpoint": "data"
  },
  "hourly": {
   "id": "global-hourly",
   "name": "Global Hourly (ISD)",
   "description": "hourly surface observations (large; short periods only)",
   "endpoint": "data"
  },
  "GHCND": {
   "id": "daily-summaries",
   "name": "GHCND (CDO name)",
   "description": "same as daily-summaries",
   "endpoint": "data"
  },
  "GSOM": {
   "id": "global-summary-of-the-month",
   "name": "GSOM (CDO name)",
   "description": "same as global-summary-of-the-month",
   "endpoint": "data"
  },
  "GSOY": {
   "id": "global-summary-of-the-year",
   "name": "GSOY (CDO name)",
   "description": "same as global-summary-of-the-year",
   "endpoint": "data"
  }
 }
}