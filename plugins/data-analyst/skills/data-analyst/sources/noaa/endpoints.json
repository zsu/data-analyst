     "desc": "FIPS:36 (state), FIPS:36061 (county), CITY:US360019 ..."
    },
    "stationid": {
     "desc": "GHCND:USW00094728"
    },
    "datatypeid": {
     "desc": "TMAX, PRCP ..."
    },
    "startdate": {
     "desc": "YYYY-MM-DD"
    },
    "enddate": {
     "desc": "YYYY-MM-DD"
    },
    "sortfield": {
     "desc": "id, name, mindate, maxdate, datacoverage"
    },
    "sortorder": {
     "desc": "asc or desc"
    },
    "extent": {
     "desc": "stations only: south,west,north,east bounding box"
    },
    "locationcategoryid": {
     "desc": "locations only: ST, CNTY, CITY, CLIM_REG, CNTRY ..."
    }
   },
   "defaults": {
    "offset": 1
   },
   "records": "results",
   "total": "metadata.resultset.count",
   "paging": {
    "type": "offset",
    "limit_param": "limit",
    "offset_param": "offset",
    "size": 1000
   },
   "max_rows": 20000,
   "missing": [
    ""
   ],
   "flatten": true
  },
  "cdo_locations": {
   "path": "/cdo-web/api/v2/locations",
   "method": "GET",
   "description": "Location ids (states FIPS:nn, counties, cities, climate regions) (CDO v2, needs NOAA_API_KEY)",
