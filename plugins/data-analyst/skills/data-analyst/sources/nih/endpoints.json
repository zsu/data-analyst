{
 "base_url": "https://api.reporter.nih.gov/v2",
 "endpoints": {
  "projects": {
   "path": "/projects/search",
   "method": "POST",
   "description": "NIH RePORTER project records (one row per project-year award) matching criteria; 500 a page, at most 15,000 per search.",
   "params": {
    "criteria": {
     "in": "body",
     "desc": "RePORTER criteria object, merged with the friendly keys below"
    },
    "text": {
     "desc": "words searched in title, terms and abstract (advanced_text_search, operator and)"
    },
    "text_fields": {
     "desc": "where to search text: projecttitle,terms,abstracttext (default all three)"
    },
    "fiscal_years": {
     "desc": "list of fiscal years, e.g. [2023, 2024]"
    },
    "agencies": {
     "desc": "administering institute codes, e.g. [\"NCI\", \"NIA\"]"
    },
    "org_states": {
     "desc": "organization state postal codes"
    },
    "org_names": {
     "desc": "organization names (contains match)"
    },
    "activity_codes": {
     "desc": "e.g. [\"R01\", \"R21\"]"
    },
    "spending_categories": {
     "desc": "RCDC category names or ids, e.g. [\"Cancer\", \"Opioids\"] (see --search)"
    },
    "pi_names": {
     "desc": "[{\"last_name\": \"...\", \"first_name\": \"...\"}] or [{\"any_name\": \"...\"}]"
    },
    "exclude_subprojects": {
     "desc": "default true: subproject rows repeat money already in the parent award"
    },
    "include_fields": {
     "in": "body",
     "desc": "PascalCase field names (AwardAmount); default a compact set; \"all\" for every field"
    },
    "sort_field": {
     "in": "body",
     "desc": "e.g. award_amount"
    },
    "sort_order": {
     "in": "body",
     "desc": "asc or desc"
    }
   },
   "records": "results",
   "total": "meta.total",
   "paging": {
    "type": "offset",
    "limit_param": "limit",
    "offset_param": "offset",
    "size": 500,
    "in": "body"
   },
   "max_rows": 15000,
   "missing": [
    ""
   ],
   "flatten": true
  },
  "publications": {
   "path": "/publications/search",
   "method": "POST",
   "description": "Publications linked to NIH projects: PMID and core project number pairs; 500 a page, at most 10,000 per search (offset above 9,999 is refused).",
   "params": {
    "criteria": {
     "in": "body",
     "desc": "{\"core_project_nums\": [...]} or {\"pmids\": [...]} or {\"appl_ids\": [...]}"
    },
    "core_project_nums": {
     "desc": "list of core project numbers, e.g. [\"R01CA282725\"]"
    },
    "pmids": {
     "desc": "list of PubMed ids"
    },
    "appl_ids": {
     "desc": "list of application ids"
    }
   },
   "records": "results",
   "total": "meta.total",
   "paging": {
    "type": "offset",
    "limit_param": "limit",
    "offset_param": "offset",
    "size": 500,
    "in": "body"
   },
   "max_rows": 10000,
   "missing": [
    ""
   ],
   "flatten": true
  }
 },
