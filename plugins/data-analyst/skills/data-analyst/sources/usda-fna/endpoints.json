{
  "base_url": "https://www.fna.usda.gov",
  "timeout": 60,
  "tableau": {
    "base_url": "https://publicdashboards.dl.usda.gov",
    "workbook": "/t/FNCS_PUB/views/SNAPPDDStateOptionsReportDashboard_17722135393810",
    "page": "https://www.fna.usda.gov/data-research/data-visualization/snap/state-options",
    "editions": {"16": "16th Edition (FY 2024)", "17": "17th Edition (FY 2025)"},
    "verified": "2026-10-30"
  },
  "endpoints": {
    "options_by_state": {
      "path": "/t/FNCS_PUB/views/SNAPPDDStateOptionsReportDashboard_17722135393810/StateAgencyComparison.csv",
      "description": "State Options Report dashboard: each state agency's selection on each policy option (not waivers or demonstration projects: use option_states or options_report). One row per state x policy option, with how many of the 53 agencies made the same selection. Editions 16 and 17.",
      "params": {
        "state": {"in": "spec", "desc": "state agency name or USPS code, a list of them, or \"all\" (default: all 53)"},
        "edition": {"in": "spec", "desc": "16 or 17 (default 17, the latest)", "enum": ["16", "17"]}
      },
      "records": "$csv",
      "paging": {"type": "none"}
    },
    "option_states": {
      "path": "/t/FNCS_PUB/views/SNAPPDDStateOptionsReportDashboard_17722135393810/OptionsProjectsWaivers.csv",
      "description": "State Options Report dashboard: the state agencies that made a selection on one option, waiver or demonstration project (one row per state x selection). Without selection: every selection of that policy, so each state appears once. Editions 16 and 17.",
      "params": {
        "policy": {"in": "spec", "required": true, "catalog": true, "desc": "policy option, waiver or project: a catalog alias (bbce, abawd_waiver ...) or its exact name (--endpoints, --search)"},
        "selection": {"in": "spec", "desc": "one selection value of that policy, exactly as in the catalog entry (default: all of them)"},
        "edition": {"in": "spec", "desc": "16 or 17 (default 17, the latest)", "enum": ["16", "17"]}
      },
      "records": "$csv",
      "paging": {"type": "none"}
    },
    "options_report": {
      "path": "/snap/waivers/state-options-report",
      "description": "State Options Report PDF (any edition, 1st 2002 to 17th 2025) as text: one row per page (edition, page, state for a state agency profile page, text). With state: only that agency's profile pages (editions 16 and 17 have one or two profile pages per agency). Needs the Python package pypdf.",
      "params": {
        "edition": {"in": "spec", "desc": "1 to 17 (default 17)"},
        "state": {"in": "spec", "desc": "optional: one state agency name or USPS code; keeps its profile pages"},
        "pages": {"in": "spec", "desc": "optional: printed PDF page numbers, e.g. \"9-12\" or \"44,45\" (the PDF's own page index, 1 = cover)"}
      },
      "paging": {"type": "none"}
    },
    "activity_tables": {
      "path": "/pd/snap-state-activity-reports",
      "description": "SNAP State Activity Report state tables (FY 2019-2023) as tidy rows: report_fy, table, state, measure, data_fy, value (as published), value_num, value_flag. Table keys: source.md (and activity_tables in this file). Ranking tables and the national summary are not parsed (same numbers; read them with activity_report). Needs the Python package pypdf.",
      "params": {
        "fiscal_year": {"in": "spec", "required": true, "desc": "report fiscal year, 2019 to 2023 (a list is allowed)"},
        "tables": {"in": "spec", "desc": "table keys from the catalog (e.g. [\"admin_costs\", \"persons_multiyear\"]) or \"all\" (default)"},
        "state": {"in": "spec", "desc": "optional: state agency names or USPS codes to keep"}
      },
      "paging": {"type": "none"}
    },
    "activity_report": {
      "path": "/pd/snap-state-activity-reports",
      "description": "SNAP State Activity Report PDF (FY 2004-2023) as text: one row per page (report_fy, page, table title, text). For years activity_tables does not parse, or the national summary and ranking tables. Needs the Python package pypdf.",
      "params": {
        "fiscal_year": {"in": "spec", "required": true, "desc": "report fiscal year, 2004 to 2023"},
        "pages": {"in": "spec", "desc": "optional: PDF page numbers, e.g. \"4\" or \"7-12\""}
      },
      "paging": {"type": "none"}
    }
  },
  "options_reports": {
    "17": {"label": "17th Report (August 2025)", "as_of": "2024-10-01", "url": "/sites/default/files/resource-files/snap-stateOptionsReport-17edition-120925.pdf"},
    "16": {"label": "16th Report (June 2024)", "as_of": "", "url": "/sites/default/files/resource-files/snap-16th-state-options-report-june24.pdf"},
