    "14": {"label": "14th Report (May 2018)", "as_of": "", "url": "/sites/default/files/snap/14-State-Options.pdf"},
    "13": {"label": "13th Report (August 2017)", "as_of": "", "url": "/sites/default/files/snap/13-State_Options-revised.pdf"},
    "12": {"label": "12th Report (April 2016)", "as_of": "", "url": "/sites/default/files/snap/12-State_Options.pdf"},
    "11": {"label": "11th Report (April 2015)", "as_of": "", "url": "/sites/default/files/snap/11-State_Options.pdf"},
    "10": {"label": "Tenth Report (August 2012)", "as_of": "", "url": "/sites/default/files/snap/10-State_Options.pdf"},
    "9": {"label": "Ninth Report (June 2011)", "as_of": "", "url": "/sites/default/files/snap/9-State_Options.pdf"},
    "8": {"label": "Eighth Report (June 2009)", "as_of": "", "url": "/sites/default/files/snap/8-State_Options.pdf"},
    "7": {"label": "Seventh Report (November 2007)", "as_of": "", "url": "/sites/default/files/snap/7-State_Options.pdf"},
    "6": {"label": "Sixth Report (October 2006)", "as_of": "", "url": "/sites/default/files/snap/6-State_Options.pdf"},
    "5": {"label": "Fifth Report (August 2005)", "as_of": "", "url": "/sites/default/files/snap/5-State_Options.pdf"},
    "4": {"label": "Fourth Report (September 2004)", "as_of": "", "url": "/sites/default/files/snap/4-State_Options.pdf"},
    "3": {"label": "Third Report (October 2003)", "as_of": "", "url": "/sites/default/files/snap/3-State_Options.pdf"},
    "2": {"label": "Second Report (May 2003)", "as_of": "", "url": "/sites/default/files/snap/2-State_Options.pdf"},
    "1": {"label": "First Report (April 2002)", "as_of": "", "url": "/sites/default/files/snap/1-State_Options.pdf"}
  },
  "activity_reports": {
    "2023": "/sites/default/files/resource-files/snap-sar-fy23.pdf",
    "2022": "/sites/default/files/resource-files/snap-sar-fy22.pdf",
    "2021": "/sites/default/files/resource-files/snap-state-activity-report-fy21.pdf",
    "2020": "/sites/default/files/resource-files/FY20-state-activity-report.pdf",
    "2019": "/sites/default/files/resource-files/FY19-state-activity-report.pdf",
    "2018": "/sites/default/files/resource-files/FY18-state-activity-report.pdf",
    "2017": "/sites/default/files/resource-files/FY17-State-Activity-Report.pdf",
    "2016": "/sites/default/files/snap/FY16-State-Activity-Report.pdf",
    "2015": "/sites/default/files/snap/FY15-State-Activity-Report.pdf",
    "2014": "/sites/default/files/FY14%20State%20Activity%20Report.pdf",
    "2013": "/sites/default/files/snap/2013-state-activity.pdf",
    "2012": "/sites/default/files/snap/2012-state-activity.pdf",
    "2011": "/sites/default/files/2011_state_activity.pdf",
    "2010": "/sites/default/files/2010_state_activity.pdf",
    "2009": "/sites/default/files/2009_state_activity.pdf",
    "2008": "/sites/default/files/2008_state_activity.pdf",
    "2007": "/sites/default/files/2007_state_activity.pdf",
    "2006": "/sites/default/files/2006_state_activity.pdf",
    "2005": "/sites/default/files/2005_state_activity.pdf",
    "2004": "/sites/default/files/2004_state_activity.pdf"
  },
  "activity_parsed_years": [2019, 2020, 2021, 2022, 2023],
  "activity_tables": {
    "participation_issuance": {"title": "SNAP Participation and Issuance -", "not": "Ranked|Emergency|Total Participation", "sum": true,
      "variants": [[["persons_participating", "Persons Participating"], ["households_participating", "Households Participating"], ["total_issuance", "Total Issuance"]]]},
    "average_benefit": {"title": "SNAP Average Monthly Benefit -", "not": "Ranked", "sum": false,
      "variants": [[["avg_benefit_per_person", "Per Person"], ["avg_benefit_per_household", "Per Household"]]]},
    "emergency_allotments": {"title": "Emergency Allotment Participation and Issuance", "sum": true,
      "variants": [[["ea_persons_participating", "Persons Participating"], ["ea_households_participating", "Households Participating"], ["ea_issuance", "Issuance"]]]},
    "households_by_benefit_type": {"title": "Benefit Type-\\s*Households", "sum": true,
      "variants": [[["households_ebt", "EBT"], ["households_cash", "Cash"], ["households_emergency_allotment", "Emergency Allotment"]],
                   [["households_ebt", "EBT"], ["households_cash", "Cash"], ["households_group_housing", "Group Housing"], ["households_total", "Total Households"]]]},
    "persons_by_benefit_type": {"title": "Benefit Type-\\s*Persons", "sum": true,
      "variants": [[["persons_ebt", "EBT"], ["persons_cash", "Cash"], ["persons_emergency_allotment", "Emergency Allotment"]],
                   [["persons_ebt", "EBT"], ["persons_cash", "Cash"], ["persons_group_housing", "Group Housing"], ["persons_total", "Total Persons"]]]},
    "issuance_by_benefit_type": {"title": "Issuance by Benefit Type", "sum": true,
      "variants": [[["issuance_ebt", "Issuance by EBT"], ["issuance_cash", "Issuance by Cash"], ["issuance_emergency_allotment", "Emergency Allotment"], ["total_issuance", "Total Issuance"]],
                   [["issuance_ebt", "Issuance by EBT"], ["issuance_cash", "Issuance by Cash"], ["issuance_group_housing", "Group Housing"], ["total_issuance", "Total Issuance"]]]},
    "admin_costs": {"title": "^TABLE \\d+:\\s*State Agency SNAP Administrative Costs - FY", "sum": true,
      "variants": [[["state_share_admin_costs", "State Share"], ["federal_share_admin_costs", "Federal Share"], ["arpa_funding", "ARPA"], ["total_admin_costs", "Total Administrative"]],
                   [["state_share_admin_costs", "State Share"], ["federal_share_admin_costs", "Federal Share"], ["total_admin_costs", "Total Administrative"]]]},
    "covid_admin_funding": {"title": "New COVID-19 Funding", "sum": true,
      "variants": [[["arpa_expenditures", "ARPA"], ["caa_expenditures", "CAA"]]]},
    "admin_costs_per_case": {"title": "^TABLE \\d+:\\s*State Agency SNAP Administrative Costs Per Case", "sum": [0, 1],
      "variants": [[["households_participating", "Households Participating"], ["total_admin_costs", "Total Administrative Costs"], ["total_admin_costs_per_case_month", "Per Case Per Month"]]]},
    "federal_admin_costs_per_case": {"title": "Federal Share of State Agency SNAP Administrative Costs Per Case", "sum": [0, 1],
      "variants": [[["households_participating", "Households Participating"], ["federal_share_total_costs", "Federal Share of Total Costs"], ["federal_admin_costs_per_case_month", "Per Case Per Month"]]]},
    "federal_selected_costs": {"title": "Selected State Agency SNAP Administrative Costs - FY", "sum": true,
      "variants": [[["federal_certification_costs", "Certification"], ["federal_issuance_costs", "Issuance"], ["federal_fraud_control_costs", "Fraud Control"]]]},
    "federal_adp_costs": {"title": "Automated Data", "sum": true,
      "variants": [[["federal_adp_development_costs", "Development"], ["federal_adp_operations_costs", "Operations"]]]},
    "federal_cert_costs_per_case": {"title": "Certification Costs Per Case", "sum": [0, 1],
      "variants": [[["households_participating", "Households Participating"], ["federal_certification_costs", "Federal Share of Certification Costs"], ["federal_cert_costs_per_case_month", "Per Case Per Month"]]]},
    "fair_hearings": {"title": "Fair Hearings Upheld and Reversed", "sum": [0, 1], "blank_last": true,
      "variants": [[["fair_hearings_upheld", "Upheld"], ["fair_hearings_reversed", "Reversed"], ["percent_upheld", "Percent Upheld"]],
                   [["fair_hearings_upheld", "Upheld"], ["fair_hearings_reversed", "Reversed"]]]},
    "adh": {"title": "Administrative Disqualification Hearings", "sum": true,
      "variants": [[["adh_ipv_found", "Intentional Program Violation found"], ["adh_waivers_signed", "Waiver"], ["adh_no_ipv_found", "No Intentional"]]]},
    "fraud_investigations": {"title": "Fraud Investigations Referred", "sum": true,
      "variants": [[["eligibility_fraud_referred", "Eligibility Fraud"], ["trafficking_referred", "Trafficking"], ["total_fraud_referred", "Total Fraud"]]]},
    "prosecutions": {"title": "Fraud Prosecution Activity", "sum": true,
      "variants": [[["prosecution_convictions", "Convictions"], ["disqualification_consent_agreements", "Consent Agreements"], ["prosecution_acquittals", "Acquittals"]]]},
    "disqualifications": {"title": "Disqualification Determinations", "sum": true,
      "variants": [[["adh_disqualifications", "ADH"], ["prosecution_disqualifications", "Prosecution"], ["total_disqualifications", "Total"]]]},
    "claims_established_dollars": {"title": "Newly Established SNAP Recipient Claim Dollars", "sum": true,
      "variants": [[["fraud_claim_dollars_established", "Fraud"], ["household_error_claim_dollars_established", "Household Error"], ["agency_error_claim_dollars_established", "Agency Error"], ["total_claim_dollars_established", "Total"]]]},
    "claims_established_count": {"title": "Newly Established SNAP Recipient Claims -", "sum": true,
      "variants": [[["fraud_claims_established", "Fraud"], ["household_error_claims_established", "Household"], ["agency_error_claims_established", "Agency Error"], ["total_claims_established", "Total"]]]},
    "claims_collected_by_type": {"title": "Claims Collected by Type", "sum": true,
      "variants": [[["fraud_claims_collected", "Fraud"], ["household_error_claims_collected", "Household Error"], ["agency_error_claims_collected", "Agency Error"], ["total_claims_collected", "Total"]]]},
    "claims_collected_by_method": {"title": "Collected by Collection Method", "sum": true,
      "variants": [[["claims_recouped", "Recouped"], ["claims_treasury_offset", "Treasury Offset"], ["claims_other_methods_refunds", "Other Collection"], ["total_claims_collected", "Total"]]]},
    "persons_multiyear": {"title": "SNAP Persons Participating \\(Monthly Average\\)", "multi": "persons_participating", "sum": true},
    "households_multiyear": {"title": "SNAP Households Participating \\(Monthly Average\\)", "multi": "households_participating", "sum": true},
    "issuance_multiyear": {"title": "^TABLE \\d+:\\s*SNAP Issuance - FY", "multi": "total_issuance", "sum": true},
    "federal_costs_multiyear": {"title": "Federal Share of State Agency SNAP Administrative Costs - FY", "multi": "federal_share_admin_costs", "sum": true},
    "federal_costs_per_case_multiyear": {"title": "Admin\\. Costs per Case", "multi": "federal_admin_costs_per_case_month", "sum": false},
    "federal_cert_costs_multiyear": {"title": "Federal Share of SNAP Certification Costs -", "multi": "federal_certification_costs", "sum": true},
    "federal_cert_costs_per_case_multiyear": {"title": "Certification Costs per Case", "multi": "federal_cert_costs_per_case_month", "sum": false},
    "fair_hearings_multiyear": {"title": "Completed Fair Hearings", "multi": "total_fair_hearings", "sum": true},
    "disqualifications_multiyear": {"title": "SNAP Total Disqualifications", "multi": "total_disqualifications", "sum": true},
    "claims_established_multiyear": {"title": "Claim Dollars - FY \\d{4}\\s*[-–]\\s*FY", "multi": "total_claim_dollars_established", "sum": true},
    "claims_collected_multiyear": {"title": "SNAP Recipient Claims Collected - FY", "multi": "total_claims_collected", "sum": true}
  },
  "catalog": {
    "program_administration": {"id": "Program Administration", "endpoint": "option_states", "description": "policy option: state-administered or county-administered SNAP",
      "selections": ["State-administered", "Region, district, or county administered"]},
    "reporting_requirements": {"id": "Reporting Requirements", "endpoint": "option_states", "description": "policy option: simplified, change or monthly reporting",
      "selections": ["Simplified reporting only", "Simplified and change reporting", "Change reporting only", "Simplified, change, and monthly reporting", "Under review"]},
    "certification_period_lengths": {"id": "Certification Period Lengths", "endpoint": "option_states", "description": "policy option: certification period lengths offered (months; an agency can offer several)",
      "selections": ["4", "6", "12", "24"]},
    "bbce": {"id": "Broad-Based Categorical Eligibility (BBCE)", "endpoint": "option_states", "description": "policy option: broad-based categorical eligibility",
      "selections": ["BBCE", "No BBCE"]},
    "child_support_payments": {"id": "Treatment of Child Support Payments", "endpoint": "option_states", "description": "policy option: child support paid excluded from income or deducted (17th: Excluded from income / Deducted from income; 16th: ... income expense exclusion / deduction)",
      "selections": ["Excluded from income", "Deducted from income", "Child support income expense exclusion", "Child support income expense deduction"]},
    "utility_expenses": {"id": "Treatment of Utility Expenses", "endpoint": "option_states", "description": "policy option: mandatory standard utility allowances (SUAs)",
      "selections": ["Mandatory SUAs", "SUAs not mandatory"]},
    "self_employment_income": {"id": "Treatment of Self-Employment Income", "endpoint": "option_states", "description": "policy option (16th edition only): self-employment costs",
      "selections": ["Actual costs only", "Another method"]},
    "noncitizens_pre_prwora": {"id": "Treatment of Income and Deductions of Ineligible Noncitizens: Pre-PRWORA", "endpoint": "option_states", "description": "policy option (16th edition only): ineligible noncitizens' income, pre-PRWORA rule",
      "selections": ["Count all", "Count all for gross income test, then count all but a prorated share for net income test", "Pre-PRWORA Count all but a prorated share"]},
    "noncitizens_post_prwora": {"id": "Treatment of Income and Deductions of Ineligible Noncitizens: Post-PRWORA", "endpoint": "option_states", "description": "policy option (16th edition only): ineligible noncitizens' income, post-PRWORA rule",
      "selections": ["Post-PRWORA Count all but a prorated share"]},
    "employment_training": {"id": "Voluntary and Mandatory SNAP Employment and Training Programs", "endpoint": "option_states", "description": "policy option (17th edition in the dashboard; the 16th edition PDF has it): voluntary and/or mandatory SNAP E&T",
      "selections": ["Voluntary only", "Mandatory only", "Voluntary and mandatory"]},
    "work_disqualification_period": {"id": "Work Requirements: Disqualification Period Policy", "endpoint": "option_states", "description": "policy option: disqualification periods for failing work requirements",
      "selections": ["Minimum disqualification periods", "Extended disqualification periods", "Extended disqualification periods and permanent disqualification after third instance of noncompliance"]},
    "work_disqualify_household": {"id": "Work Requirements: Option to Disqualify the Entire Household", "endpoint": "option_states", "description": "policy option: disqualify the whole household when the head fails work requirements (wording differs by edition: entire / whole)",
      "selections": ["Disqualify only the individual who fails to comply", "Disqualify the entire household if the head of household fails to comply", "Disqualify the whole household if the head of household fails to comply"]},
    "child_support_disqualifications": {"id": "Child Support–Related Disqualifications", "endpoint": "option_states", "description": "policy option: disqualification for failure to cooperate with child support (the name has an en dash)",
      "selections": ["None", "Failure to cooperate: disqualification for custodial parent", "Failure to cooperate: disqualification for custodial and noncustodial parent", "Failure to cooperate: disqualification for custodial and noncustodial parent and arrearage on support payments", "Failure to cooperate: disqualification for noncustodial parent and arrearage on support payments"]},
    "comparable_disqualifications": {"id": "Comparable Disqualifications", "endpoint": "option_states", "description": "policy option: disqualify SNAP for a comparable sanction in another program",
      "selections": ["Comparable disqualifications", "No comparable disqualifications"]},
    "drug_felony": {"id": "Drug Felony Disqualifications", "endpoint": "option_states", "description": "policy option: drug felony ban (lifetime, modified or none)",
      "selections": ["No disqualification", "Modified disqualification", "Lifetime disqualification"]},
    "tba": {"id": "Transitional Benefits Alternative", "endpoint": "option_states", "description": "policy option: transitional benefits for households leaving TANF",
      "selections": ["TBA", "No TBA"]},
    "abawd_exemptions": {"id": "ABAWD Discretionary Exemptions", "endpoint": "option_states", "description": "policy option: use of ABAWD discretionary exemptions",
      "selections": ["Use of discretionary exemptions", "No use of discretionary exemptions"]},
    "pledge_states": {"id": "Pledge States", "endpoint": "option_states", "description": "policy option (17th edition): pledge to offer E&T slots to at-risk ABAWDs",
      "selections": ["Pledge State", "Not a pledge State"]},
    "abawd_waiver": {"id": "ABAWD Time Limit Waiver", "endpoint": "option_states", "description": "waiver: ABAWD time limit waiver (statewide, partial or none)",
      "selections": ["Statewide ABAWD time limit waiver", "Partial ABAWD time limit waiver", "No ABAWD time limit waiver"]},
    "change_of_address_waiver": {"id": "Alter Procedures when Change of Address is Reported Waiver", "endpoint": "option_states", "description": "waiver (17th edition)",
      "selections": ["Waiver to alter procedures when change of address is reported", "No waiver to alter procedures when change of address is reported"]},
    "on_demand_interview_waiver": {"id": "Conduct Unscheduled Interviews (On Demand) Waiver", "endpoint": "option_states", "description": "waiver (17th edition): on-demand interviews",
      "selections": ["On demand waiver", "No on demand waiver"]},
    "early_denial_waiver": {"id": "Deny Applications Before the 30th Day (Early Denial) Waiver", "endpoint": "option_states", "description": "waiver (17th edition): early denial",
      "selections": ["Early denial waiver", "No early denial waiver"]},
    "pre_release_waiver": {"id": "Pre-Release Applications From Institutions Waiver", "endpoint": "option_states", "description": "waiver (17th edition): applications from people leaving institutions",
      "selections": ["Waiver to accept pre-release applications", "No waiver to accept pre-release applications"]},
    "elderly_recert_interview_waiver": {"id": "Recertification Interview for Elderly or Disabled Households Waiver", "endpoint": "option_states", "description": "waiver (17th edition): no recertification interview for elderly or disabled households",
      "selections": ["Elderly/disabled recertification interview waiver", "No elderly/disabled recertification interview waiver"]},
    "reinstatement_waiver": {"id": "Reinstate Eligibility (Reinstatement) Waiver", "endpoint": "option_states", "description": "waiver (17th edition): reinstatement",
      "selections": ["Reinstatement waiver", "No reinstatement waiver"]},
    "shorten_certification_waiver": {"id": "Shorten Certification Periods for Certain Households Waiver", "endpoint": "option_states", "description": "waiver (17th edition)",
      "selections": ["Waiver to shorten certification periods for certain households", "No waiver to shorten certification periods for certain households"]},
    "telephonic_signature_waiver": {"id": "Telephonic Signature Waiver", "endpoint": "option_states", "description": "waiver (17th edition): telephonic signatures",
      "selections": ["Telephonic signature waiver", "No telephonic signature waiver"]},
    "text_alerts_waiver": {"id": "Text Message Alerts (for Electronic Notices) Waiver", "endpoint": "option_states", "description": "waiver (17th edition): text message alerts only for electronic notices",
      "selections": ["Send text message alerts only (for Electronic Notices) waiver", "No send text message alerts only (for Electronic Notices) waiver"]},
    "cap": {"id": "Combined Application Projects", "endpoint": "option_states", "description": "demonstration project: combined SSI/SNAP application (CAP)",
      "selections": ["Standard CAP", "Modified CAP", "No CAP"]},
    "esap": {"id": "Elderly Simplified Application Project", "endpoint": "option_states", "description": "demonstration project: ESAP",
      "selections": ["ESAP", "No ESAP"]},
    "smd": {"id": "Standard Medical Deduction Project", "endpoint": "option_states", "description": "demonstration project: standard medical deduction",
      "selections": ["SMD", "No SMD"]}
  }
}
