{
 "base_url": "https://api.congress.gov/v3",
 "endpoints": {
  "bills": {
   "path": "/bill/{congress}/{billType}",
   "method": "GET",
   "description": "Bills of one type in a Congress (latest action, title, update date). No keyword search: use govinfo search for text, or title_contains.",
   "params": {
    "congress": {
     "in": "path",
     "required": true,
     "desc": "Congress number, e.g. 118, or 'current'"
    },
    "billType": {
     "in": "path",
     "required": true,
     "desc": "hr | s | hjres | sjres | hconres | sconres | hres | sres",
     "enum": [
      "hr",
      "s",
      "hjres",
      "sjres",
      "hconres",
      "sconres",
      "hres",
      "sres"
     ]
    },
    "fromDateTime": {
     "desc": "updated on or after YYYY-MM-DDT00:00:00Z"
    },
    "toDateTime": {
     "desc": "updated on or before YYYY-MM-DDT00:00:00Z"
    },
    "title_contains": {
     "desc": "keep rows whose title contains this phrase (words in order, each at a word start, any case) or any phrase of a list (filtered by the pack after download)"
    },
    "sort": {
     "desc": "updateDate+desc (default), updateDate+asc, introducedDate+desc or introducedDate+asc",
     "enum": [
      "updateDate+desc",
      "updateDate+asc",
      "introducedDate+desc",
      "introducedDate+asc"
     ]
    }
   },
   "records": "bills",
   "paging": {
    "type": "offset",
    "limit_param": "limit",
    "offset_param": "offset",
    "size": 250
   },
   "defaults": {
    "format": "json"
   },
   "max_rows": 50000,
   "total": "pagination.count"
  },
