{
 "base_url": "https://api.usaspending.gov/api/v2",
 "endpoints": {
  "awards": {
   "path": "/search/spending_by_award/",
   "method": "POST",
   "description": "Prime awards matching filters (one award type group per request); Award Amount is the award's total obligation, not the period's.",
   "params": {
    "fiscal_year": {
     "desc": "federal fiscal year (FY2024 = 2023-10-01..2024-09-30), or [first, last]; earliest FY2008"
    },
    "start_date": {
     "desc": "YYYY-MM-DD, not before 2007-10-01 (instead of fiscal_year)"
    },
    "end_date": {
     "desc": "YYYY-MM-DD"
    },
    "award_type": {
     "desc": "award type group (contracts, idvs, grants, loans, direct_payments, other_financial_assistance, insurance) or a list of codes from ONE group"
    },
    "keyword": {
     "desc": "text search (string or list)"
    },
    "state": {
     "desc": "place of performance state: USPS code, FIPS or name"
    },
    "agency": {
     "desc": "awarding toptier agency: code (075), alias (hhs) or exact name"
    },
    "funding_agency": {
     "desc": "funding toptier agency: code, alias or exact name"
    },
    "recipient": {
     "desc": "recipient name or UEI search text"
    },
    "filters": {
     "desc": "raw API filters object; merged over the convenience parameters"
    },
    "fields": {
     "desc": "columns to return (defaults to a standard set)"
    },
    "sort": {
     "desc": "a field name in fields (default Award Amount; Loan Value for loans)"
    },
    "order": {
     "desc": "desc or asc"
    }
   },
   "body": {
    "fields": [
     "Award ID",
     "Recipient Name",
     "recipient_id",
     "Award Amount",
     "Total Outlays",
     "Awarding Agency",
     "Awarding Sub Agency",
     "Award Type",
     "Description",
     "Start Date",
     "End Date",
     "Place of Performance State Code",
     "generated_internal_id"
    ],
    "sort": "Award Amount",
    "order": "desc"
   },
   "records": "results",
   "paging": {
    "type": "page",
    "page_param": "page",
    "size_param": "limit",
    "size": 100,
    "start": 1,
    "in": "body"
   },
   "max_rows": 10000
  },
  "by_category": {
   "path": "/search/spending_by_category/{category}/",
   "method": "POST",
   "description": "Obligations in the period (transaction action dates) by one category: awarding_agency, awarding_subagency, funding_agency, recipient, cfda, naics, psc, state_territory, county, district, country, federal_account, defc.",
   "params": {
    "category": {
     "in": "path",
     "required": true,
     "desc": "category",
     "enum": [
      "awarding_agency",
      "awarding_subagency",
      "funding_agency",
      "funding_subagency",
      "recipient",
      "cfda",
      "naics",
      "psc",
      "state_territory",
      "county",
      "district",
      "country",
      "federal_account",
      "defc"
     ]
    },
    "fiscal_year": {
     "desc": "federal fiscal year (FY2024 = 2023-10-01..2024-09-30), or [first, last]; earliest FY2008"
    },
    "start_date": {
     "desc": "YYYY-MM-DD, not before 2007-10-01 (instead of fiscal_year)"
    },
    "end_date": {
     "desc": "YYYY-MM-DD"
    },
    "award_type": {
     "desc": "award type group (contracts, idvs, grants, loans, direct_payments, other_financial_assistance, insurance) or a list of codes from ONE group"
    },
    "keyword": {
     "desc": "text search (string or list)"
    },
    "state": {
     "desc": "place of performance state: USPS code, FIPS or name"
    },
    "agency": {
     "desc": "awarding toptier agency: code (075), alias (hhs) or exact name"
    },
    "funding_agency": {
     "desc": "funding toptier agency: code, alias or exact name"
    },
    "recipient": {
     "desc": "recipient name or UEI search text"
    },
    "filters": {
     "desc": "raw API filters object; merged over the convenience parameters"
    }
   },
   "body": {},
   "records": "results",
   "paging": {
    "type": "page",
    "page_param": "page",
    "size_param": "limit",
    "size": 100,
    "start": 1,
    "in": "body"
   },
   "max_rows": 5000
  },
  "over_time": {
   "path": "/search/spending_over_time/",
   "method": "POST",
   "description": "Obligations by fiscal year, fiscal quarter or fiscal month, with contract/grant/loan/direct/other splits.",
   "params": {
    "group": {
     "desc": "fiscal_year, quarter or month (fiscal)",
     "enum": [
      "fiscal_year",
      "quarter",
      "month"
     ]
    },
    "fiscal_year": {
     "desc": "federal fiscal year (FY2024 = 2023-10-01..2024-09-30), or [first, last]; earliest FY2008"
    },
    "start_date": {
     "desc": "YYYY-MM-DD, not before 2007-10-01 (instead of fiscal_year)"
    },
    "end_date": {
     "desc": "YYYY-MM-DD"
    },
    "award_type": {
     "desc": "award type group (contracts, idvs, grants, loans, direct_payments, other_financial_assistance, insurance) or a list of codes from ONE group"
    },
    "keyword": {
     "desc": "text search (string or list)"
    },
    "state": {
     "desc": "place of performance state: USPS code, FIPS or name"
    },
    "agency": {
     "desc": "awarding toptier agency: code (075), alias (hhs) or exact name"
    },
    "funding_agency": {
     "desc": "funding toptier agency: code, alias or exact name"
    },
    "recipient": {
     "desc": "recipient name or UEI search text"
    },
    "filters": {
     "desc": "raw API filters object; merged over the convenience parameters"
    }
   },
   "defaults": {
    "group": "fiscal_year"
   },
   "body": {},
   "records": "results",
   "paging": {
    "type": "none"
   }
  },
  "by_geography": {
   "path": "/search/spending_by_geography/",
   "method": "POST",
   "description": "Obligations in the period by state, county or congressional district (place of performance or recipient location), with population and per capita.",
   "params": {
    "scope": {
     "desc": "place_of_performance or recipient_location",
     "enum": [
      "place_of_performance",
      "recipient_location"
     ]
    },
    "geo_layer": {
     "desc": "state, county or district",
     "enum": [
      "state",
      "county",
      "district"
     ]
    },
    "geo_layer_filters": {
     "desc": "list of shape codes to keep, e.g. [\"MD\"] or county FIPS"
    },
    "fiscal_year": {
     "desc": "federal fiscal year (FY2024 = 2023-10-01..2024-09-30), or [first, last]; earliest FY2008"
    },
    "start_date": {
     "desc": "YYYY-MM-DD, not before 2007-10-01 (instead of fiscal_year)"
    },
    "end_date": {
     "desc": "YYYY-MM-DD"
    },
    "award_type": {
     "desc": "award type group (contracts, idvs, grants, loans, direct_payments, other_financial_assistance, insurance) or a list of codes from ONE group"
    },
    "keyword": {
     "desc": "text search (string or list)"
    },
    "state": {
     "desc": "place of performance state: USPS code, FIPS or name"
    },
    "agency": {
     "desc": "awarding toptier agency: code (075), alias (hhs) or exact name"
    },
    "funding_agency": {
     "desc": "funding toptier agency: code, alias or exact name"
    },
    "recipient": {
     "desc": "recipient name or UEI search text"
    },
    "filters": {
     "desc": "raw API filters object; merged over the convenience parameters"
    }
   },
   "defaults": {
    "scope": "place_of_performance",
    "geo_layer": "state"
   },
   "body": {},
   "records": "results",
   "paging": {
    "type": "none"
   }
  },
  "award_count": {
   "path": "/search/spending_by_award_count/",
   "method": "POST",
