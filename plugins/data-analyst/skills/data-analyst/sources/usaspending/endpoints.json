   "paging": {
    "type": "none"
   }
  },
  "agency": {
   "path": "/agency/{toptier_code}/",
   "method": "GET",
   "description": "Agency overview for a fiscal year: name, abbreviation, mission, website, subtier count.",
   "params": {
    "toptier_code": {
     "in": "path",
     "required": true,
     "catalog": true,
     "desc": "toptier code (075) or alias (hhs)"
    },
    "fiscal_year": {
     "desc": "fiscal year (default: current)"
    }
   },
   "records": "",
   "paging": {
    "type": "none"
   }
  },
  "agency_budgetary_resources": {
   "path": "/agency/{toptier_code}/budgetary_resources/",
   "method": "GET",
   "description": "Agency budgetary resources, obligations and outlays by fiscal year (agency_data_by_year), with cumulative obligations by period.",
   "params": {
    "toptier_code": {
     "in": "path",
     "required": true,
     "catalog": true,
     "desc": "toptier code or alias"
    }
   },
   "records": "agency_data_by_year",
   "paging": {
    "type": "none"
   }
  },
  "toptier_agencies": {
   "path": "/references/toptier_agencies/",
   "method": "GET",
   "description": "Every toptier agency with code, abbreviation, current-year budget authority, obligations and outlays.",
   "params": {
    "sort": {
     "desc": "agency_name, budget_authority_amount, obligated_amount, outlay_amount"
    },
    "order": {
     "desc": "asc or desc"
    }
   },
   "records": "results",
   "paging": {
    "type": "none"
   }
  },
  "recipient_state": {
   "path": "/recipient/state/{fips}/",
   "method": "GET",
   "description": "Prime award totals for one state (place of performance) in a fiscal year.",
   "params": {
    "fips": {
     "in": "path",
     "desc": "state FIPS (24); or give 'state' (MD, Maryland)"
    },
    "state": {
     "desc": "state USPS code, FIPS or name (fills fips)"
    },
    "year": {
     "desc": "fiscal year, 'latest' or 'all'"
    }
   },
   "records": "",
   "paging": {
    "type": "none"
   }
  },
  "award": {
   "path": "/awards/{award_id}/",
   "method": "GET",
   "description": "One award in detail by its generated_internal_id (CONT_AWD_..., ASST_NON_...).",
   "params": {
    "award_id": {
     "in": "path",
     "required": true,
     "desc": "generated_internal_id from the awards endpoint"
    }
   },
   "records": "",
   "paging": {
    "type": "none"
   }
  }
 },
