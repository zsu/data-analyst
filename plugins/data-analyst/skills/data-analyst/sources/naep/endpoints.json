{
  "base_url": "https://www.nationsreportcard.gov",
  "endpoints": {
    "scores": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "NAEP estimates (type=data): average scale scores, achievement-level or row percents, percentiles, with standard errors (QCData=true), by subject, grade, jurisdiction(s), year(s) and student group.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "reading, math (mathematics), science, writing, civics, history, geography, economics, tel, music"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "4, 8 or 12"},
        "subscale": {"desc": "scale code; default is the subject's composite (math grade 12: MWPCM). --search sub: lists them"},
        "variable": {"desc": "student group: TOTAL, SDRACE, GENDER, SLUNCH3, PARED, SCHTYPE, UTOL4, IEP, LEP; crosstab A+B (SDRACE+GENDER)"},
        "jurisdiction": {"desc": "NP (national public), NT (national), state codes (CA), districts (XN = New York City); comma-separated for several"},
        "stattype": {"desc": "MN:MN mean (default); ALC:AB / ALC:AP / ALC:AD at or above Basic/Proficient/Advanced; RP:RP row percent; PC:P1/P2/P5/P7/P9 = 10th/25th/50th/75th/90th percentile (no other PC codes); comma-separated for several"},
        "Year": {"desc": "2024, comma list 2024,2022,2019, or Current / Prior / Base; R2 suffix = non-accommodated sample (e.g. 1998R2)"},
        "categoryindex": {"desc": "restrict a variable to some categories, e.g. 1,2"},
        "StackType": {"enum": ["ColThenRow", "RowThenCol"], "desc": "row order for crosstabs"}
      },
      "defaults": {"type": "data", "variable": "TOTAL", "jurisdiction": "NP", "stattype": "MN:MN", "Year": "Current", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "achievement_levels": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Cumulative achievement-level percents: below Basic, at or above Basic, at or above Proficient, at Advanced (one row per stattype), with standard errors.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "4, 8 or 12"},
        "subscale": {"desc": "default composite"},
        "variable": {"desc": "student group (default TOTAL)"},
        "jurisdiction": {"desc": "jurisdiction code(s)"},
        "Year": {"desc": "year(s)"}
      },
      "defaults": {"type": "data", "variable": "TOTAL", "jurisdiction": "NP", "stattype": "ALC:BB,ALC:AB,ALC:AP,ALC:AD", "Year": "Current", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "compare_years": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Significance test between years (type=sigacrossyear): focal and target values, gap, sig (HIGHER / LOWER / EQUAL), pValue, seDiff. Needs 2+ years.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "grade"},
        "Year": {"required": true, "desc": "two or more years: 2024,2019"},
        "subscale": {"desc": "default composite"}, "variable": {"desc": "default TOTAL"},
        "jurisdiction": {"desc": "default NP"}, "stattype": {"desc": "default MN:MN"}
      },
      "defaults": {"type": "sigacrossyear", "variable": "TOTAL", "jurisdiction": "NP", "stattype": "MN:MN", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "compare_jurisdictions": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Significance test between jurisdictions (type=sigacrossjuris), every ordered pair. Needs 2+ jurisdictions.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "grade"},
        "jurisdiction": {"required": true, "desc": "two or more codes: NP,MA,MS"},
        "subscale": {"desc": "default composite"}, "variable": {"desc": "default TOTAL"},
        "Year": {"desc": "default Current"}, "stattype": {"desc": "default MN:MN"}
      },
      "defaults": {"type": "sigacrossjuris", "variable": "TOTAL", "stattype": "MN:MN", "Year": "Current", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "compare_groups": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Significance test between categories of one student-group variable (type=sigacrossvalue), e.g. male vs female. variable must not be TOTAL.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "grade"},
        "variable": {"required": true, "desc": "SDRACE, GENDER, SLUNCH3, ... (not TOTAL)"},
        "subscale": {"desc": "default composite"}, "jurisdiction": {"desc": "default NP"},
        "Year": {"desc": "default Current"}, "categoryindex": {"desc": "restrict categories"}, "stattype": {"desc": "default MN:MN"}
      },
      "defaults": {"type": "sigacrossvalue", "jurisdiction": "NP", "stattype": "MN:MN", "Year": "Current", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "gap_years_across_jurisdictions": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Is one jurisdiction's change between two years different from another's? (type=gaponyearacrossjuris). Exactly 2 years, 2+ jurisdictions.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "grade"},
        "Year": {"required": true, "desc": "exactly two years: 2024,2019"},
        "jurisdiction": {"required": true, "desc": "two or more codes"},
        "subscale": {"desc": "default composite"}, "variable": {"desc": "default TOTAL"}, "stattype": {"desc": "default MN:MN"}
      },
      "defaults": {"type": "gaponyearacrossjuris", "variable": "TOTAL", "stattype": "MN:MN", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "gap_groups_across_years": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Did a group gap (e.g. female minus male) change between years? (type=gaponvaracrossyear). 2+ years, variable not TOTAL.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "grade"},
        "variable": {"required": true, "desc": "group variable (not TOTAL)"},
        "Year": {"required": true, "desc": "two or more years"},
        "subscale": {"desc": "default composite"}, "jurisdiction": {"desc": "default NP"}, "stattype": {"desc": "default MN:MN"}
      },
      "defaults": {"type": "gaponvaracrossyear", "jurisdiction": "NP", "stattype": "MN:MN", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "gap_groups_across_jurisdictions": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Is a group gap larger in one jurisdiction than another? (type=gaponvaracrossjuris). 2+ jurisdictions, variable not TOTAL.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "grade": {"required": true, "enum": [4, 8, 12], "desc": "grade"},
        "variable": {"required": true, "desc": "group variable (not TOTAL)"},
        "jurisdiction": {"required": true, "desc": "two or more codes"},
        "subscale": {"desc": "default composite"}, "Year": {"desc": "default Current"}, "stattype": {"desc": "default MN:MN"}
      },
      "defaults": {"type": "gaponvaracrossjuris", "stattype": "MN:MN", "Year": "Current", "QCData": "true"},
      "records": "result", "paging": {"type": "none"}, "max_rows": 50000
    },
    "variables": {
      "path": "/Dataservice/GetAdhocData.aspx",
      "description": "Independent (student-group and questionnaire) variables available for a subject, cohort (1 = grade 4, 2 = grade 8, 3 = grade 12) and year.",
      "params": {
        "subject": {"required": true, "catalog": true, "desc": "subject"},
        "cohort": {"required": true, "enum": [1, 2, 3], "desc": "1 = grade 4, 2 = grade 8, 3 = grade 12"},
        "Year": {"required": true, "desc": "one year, e.g. 2024"}
      },
      "defaults": {"type": "independentvariables"},
      "records": "result.0.variables", "paging": {"type": "none"}, "max_rows": 50000
    }
  },
  "catalog": {
